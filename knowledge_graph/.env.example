# Copy to .env (repo-root or this directory) and fill in real values.
# Never commit the filled-in .env — .gitignore already excludes .env* except this file.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=your-instance-id
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=your-instance-id

# Aura *account* API credentials — NOT the database password above. Needed only by
# gds_prototype.py (ADR-0009) to provision an ephemeral Aura Graph Analytics session.
# Generate from the Aura Console: account menu (top right) -> "Aura API and Credentials"
# -> Create. The secret is shown once — save it immediately.
AURA_API_CLIENT_ID=your-aura-api-client-id
AURA_API_CLIENT_SECRET=your-aura-api-client-secret
