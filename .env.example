# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD, NEO4J_DATABASE: AuraDB connection details
# for the Art Context Knowledge Graph (see src/appraisal/knowledge_graph/). Same
# instance the Python ingestion toolkit at repo-root knowledge_graph/ populates —
# share one .env between the two.
NEO4J_URI="neo4j+s://your-instance-id.databases.neo4j.io"
NEO4J_USER="your-instance-id"
NEO4J_PASSWORD="your-password"
NEO4J_DATABASE="your-instance-id"

# EMBEDDING_SERVICE_URL: base URL for Stage 1d's local Python embedding microservice
# (knowledge_graph/embedding_service.py — see that file and knowledge_graph/README.md
# "Running the embedding service"). Optional — defaults to http://127.0.0.1:8008 if unset;
# Stage 1d degrades to a skipped/empty result if the service isn't reachable.
EMBEDDING_SERVICE_URL="http://127.0.0.1:8008"
