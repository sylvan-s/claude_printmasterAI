# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD, NEO4J_DATABASE: AuraDB connection details
# for the Art Context Knowledge Graph (see src/appraisal/knowledge_graph/). Same
# instance the Python ingestion toolkit at repo-root knowledge_graph/ populates —
# share one .env between the two.
NEO4J_URI="neo4j+s://your-instance-id.databases.neo4j.io"
NEO4J_USER="your-instance-id"
NEO4J_PASSWORD="your-password"
NEO4J_DATABASE="your-instance-id"
