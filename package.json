{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "bench:fetch": "tsx benchmark/src/roseberys/extract.ts",
    "forum:fetch": "tsx benchmark/src/forum/extract.ts",
    "lookup:artist": "tsx src/appraisal/reference_lookup/cli.ts",
    "test:vea": "tsx tests/vea/run_vea_trial.ts",
    "test:backtest": "tsx tests/backtest/run_backtest.ts",
    "test:routing": "tsx tests/routing/run_routing_tests.ts",
    "query:ackg": "tsx src/appraisal/knowledge_graph/cli.ts",
    "test:two-pass": "tsx tests/two_pass_attribution/run_tests.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "neo4j-driver": "^5.28.3",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.8.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
